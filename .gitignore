# Qt Creator
.qtcreator/
*.pro.user
*.pro.user.*
CMakeLists.txt.user*

# Build output
build/
build-*/
debug/
release/
Makefile*
*.o
*.obj
*.exe
*.dll
*.pdb
*.ilk

# Qt-generated artifacts (in case they ever land in the source tree)
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
.qmake.stash
qmake_*.qrc

# In-source build output. The app binary is extensionless on Linux, so
# anchor it to the repo root — an unanchored "Pixee" would also swallow a
# Pixee/ directory if one is ever added. Test binaries sit next to their
# sources, hence the .cpp re-include so new suites stay visible to git.
/Pixee
tests/*/tst_*
!tests/*/tst_*.cpp

# OS noise
.DS_Store
Thumbs.db

# Test images (Kling-generated samples used to exercise copy / move / etc.)
kling_*

# Local scratch folder used to exercise paste / move flows.
themes/new/

# Portable distribution dir (Qt deploy output, not source).
Pixee-portable/
