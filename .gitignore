# Qt Creator
.qtcreator/
*.pro.user
*.pro.user.*
CMakeLists.txt.user*

# Build output
build/
build-*/
debug/
release/
Makefile*
*.o
*.obj
*.exe
*.dll
*.pdb
*.ilk

# Qt-generated artifacts (in case they ever land in the source tree)
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
.qmake.stash
qmake_*.qrc

# In-source build output. The app binary is extensionless on Linux, so
# anchor it to the repo root — an unanchored "Pixee" would also swallow a
# Pixee/ directory if one is ever added. Test binaries sit next to their
# sources, hence the .cpp re-include so new suites stay visible to git.
/Pixee
tests/*/tst_*
!tests/*/tst_*.cpp

# OS noise
.DS_Store
Thumbs.db

# Test images (Kling-generated samples used to exercise copy / move / etc.)
kling_*

# Local scratch folder used to exercise paste / move flows.
themes/new/

# Portable distribution (Qt deploy output + its zip, not source).
Pixee-portable/
Pixee-portable.zip

# Installer output (Inno Setup compiles the portable into dist\).
dist/

# Prebuilt HEIC/AVIF/PSD/XCF plugins + codec DLLs are intentionally checked
# in (vcpkg, their build source, is gone) so make-portable.bat can bundle
# them. Override the blanket *.dll ignore above for this one tree.
!thirdparty/imageformats/codecs/*.dll
!thirdparty/imageformats/plugins/*.dll
